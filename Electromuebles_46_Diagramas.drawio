  <diagram id="indice" name="00 - Índice y leyenda">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="ELECTROMUEBLES — DEA, DERE y DER&#xa;46 diagramas organizados por categoría" style="text;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="80" width="1000" height="90" as="geometry"/></mxCell><mxCell id="l" value="LEYENDA&#xa;DEA: entidad + atributos, PK, claves candidatas y FK&#xa;DERE: relación directa, cardinalidad y entidad fuerte/débil&#xa;DER: relaciones principales y cardinalidades&#xa;&#xa;Borde doble = entidad fuerte | borde simple = entidad débil&#xa;Cardinalidades usadas: 1-1, 1-M y N-M" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=18;spacing=20;" vertex="1" parent="1"><mxGeometry x="380" y="250" width="840" height="300" as="geometry"/></mxCell></root>
    </mxGraphModel>
  </diagram>
  <diagram id="d01" name="01.1 - Sucursal"><mxGraphModel dx="1200" dy="800" grid="1" page="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a" value="Categoría 1 — Administración, Ubicación y Seguridad&#xa;DEA: SUCURSAL&#xa;&#xa;PK id_sucursal: INT (1001)&#xa;nombre: VARCHAR(100) (Centro Norte)&#xa;direccion: VARCHAR(200)&#xa;telefono: VARCHAR(20)&#xa;email: VARCHAR(100)&#xa;FK id_ciudad: INT (15)&#xa;estado: BOOLEAN (TRUE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=16;spacing=15;" vertex="1" parent="1"><mxGeometry x="70" y="100" width="440" height="420" as="geometry"/></mxCell><mxCell id="b" value="DERE&#xa;SUCURSAL (FUERTE) ═══ tiene 1-M ═══ USUARIO (DÉBIL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;fontSize=17;spacing=15;" vertex="1" parent="1"><mxGeometry x="600" y="160" width="540" height="150" as="geometry"/></mxCell><mxCell id="c" value="DER&#xa;Sucursal (1) — administra — (M) Factura&#xa;Sucursal (1) — tiene — (M) Usuario&#xa;Sucursal (1) — posee — (M) Almacén" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=17;spacing=15;" vertex="1" parent="1"><mxGeometry x="600" y="370" width="540" height="180" as="geometry"/></mxCell></root></mxGraphModel></diagram>
  <diagram id="d02" name="01.2 - Ciudad"><mxGraphModel dx="1200" dy="800" grid="1" page="1"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a" value="Categoría 1 — Administración, Ubicación y Seguridad&#xa;DEA: CIUDAD&#xa;&#xa;PK id_ciudad: INT (15)&#xa;nombre: VARCHAR(80) (Quito)&#xa;codigo_postal: VARCHAR(12)&#xa;FK id_provincia: INT (3)&#xa;estado: BOOLEAN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=16;spacing=15;" vertex="1" parent="1"><mxGeometry x="70" y="130" width="440" height="330" as="geometry"/></mxCell><mxCell id="b" value="DERE&#xa;PROVINCIA (FUERTE) ═══ tiene 1-M ═══ CIUDAD (DÉBIL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;fontSize=17;spacing=15;" vertex="1" parent="1"><mxGeometry x="600" y="180" width="540" height="150" as="geometry"/></mxCell><mxCell id="c" value="DER&#xa;Provincia (1) — contiene — (M) Ciudad&#xa;Ciudad (1) — localiza — (M) Sucursal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=17;spacing=15;" vertex="1" parent="1"><mxGeometry x="600" y="390" width="540" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram>
