  <diagram id="legend" name="LEYENDA">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="LEYENDA Y ESTRUCTURA DEL ARCHIVO" style="text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="30" width="1000" height="50" as="geometry"/></mxCell><mxCell id="l1" value="🔑 [PK] CLAVE PRIMARIA - amarillo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="130" width="1100" height="40" as="geometry"/></mxCell><mxCell id="l2" value="🔗 [FK] CLAVE FORÁNEA - rojo/rosa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="190" width="1100" height="40" as="geometry"/></mxCell><mxCell id="l3" value="* [CANDIDATA] CLAVE ÚNICA - verde" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5F4E6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="250" width="1100" height="40" as="geometry"/></mxCell><mxCell id="l4" value="Atributos regulares - verde claro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2EFDA;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="310" width="1100" height="40" as="geometry"/></mxCell><mxCell id="note" value="ARCHIVO COMPLETO: 138 DIAGRAMAS TOTALES&#xa;&#xa;CATEGORÍA 1: 12 diagramas (4 entidades x 3 tipos)&#xa;  - Sucursal, Ciudad, Usuario, Provincia&#xa;&#xa;CATEGORÍA 2: 21 diagramas (7 entidades x 3 tipos)&#xa;  - Cargo, Empleado, Vendedor, Nómina, Descuento, Impuesto, Dpto.&#xa;&#xa;CATEGORÍA 3: 24 diagramas (8 entidades x 3 tipos)&#xa;  - Categoría, Marca, Producto, Unidad, Almacén, Transf, Grupo, Dpto.&#xa;&#xa;CATEGORÍA 4: 15 diagramas (5 entidades x 3 tipos)&#xa;  - Cliente, Cotización, Factura, Devolución, Entrega&#xa;&#xa;CATEGORÍA 5: 12 diagramas (4 entidades x 3 tipos)&#xa;  - Proveedor, Orden de Compra, Compra, Devolución&#xa;&#xa;CATEGORÍA 6: 18 diagramas (6 entidades x 3 tipos)&#xa;  - CxC, Nota Cr. CxC, Nota Db. CxC, CxP, Nota Cr. CxP, Nota Db. CxP&#xa;&#xa;CATEGORÍA 7: 12 diagramas (4 entidades x 3 tipos)&#xa;  - Caja, Apertura, Cierre, Recibo&#xa;&#xa;CATEGORÍA 8: 24 diagramas (8 entidades x 3 tipos)&#xa;  - Banco, Cuenta, Depósito, Cheque, Transferencia, Nota Db., Nota Cr., Conciliación&#xa;&#xa;CADA DIAGRAMA TIENE:&#xa;DEA - Entidad central con óvalos de atributos\nDERE - Relaciones extendidas con entidades fuerte/débil\nDER - Relaciones principales con cardinalidades" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;fontSize=11;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="150" y="400" width="1100" height="450" as="geometry"/></mxCell></root>
    </mxGraphModel>
  </diagram>
</mxfile>